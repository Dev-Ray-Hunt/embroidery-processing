.coverage
htmlcov/

# ==== Data — public samples & Madeira sources stay out of git ====
data/sample_dsts/*
!data/sample_dsts/.gitkeep
data/madeira_sources/*
!data/madeira_sources/.gitkeep

# ==== POC outputs (rendered images, scorecards, generated catalogue) ====
outputs/*
!outputs/.gitkeep
# Benchmark report is a committed deliverable (generated by scripts/benchmark_matching.py)
!outputs/poc2/
outputs/poc2/*
!outputs/poc2/matching_benchmark.md
