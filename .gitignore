__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/
.env

# ==== Node ====
node_modules/
npm-debug.log*
yarn-error.log*

# ==== IDEs ====
.vscode/
.idea/
*.swp
*.swo
*~

# ==== Output / generated ====
*.dst
*.pes
*.jef
*.exp
output/
tmp/

